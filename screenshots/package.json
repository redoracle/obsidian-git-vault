{
    "name": "obsidian-git-vault-screenshots",
    "private": true,
    "description": "Playwright screenshot harness for obsidian-git-vault documentation",
    "scripts": {
        "test": "playwright test",
        "screenshot": "playwright screenshot",
        "screenshot:headed": "playwright test --headed",
        "install-browsers": "playwright install chromium",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^22.20.2",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=22 <23"
    }
}
