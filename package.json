{
  "name": "git-vault",
  "version": "1.1.2",
  "description": "Hybrid Git + GitHub API sync for Obsidian with desktop power features and mobile-first reliability",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint src",
    "format": "prettier --check src",
    "tsc": "tsc --noEmit",
    "svelte": "svelte-check",
    "all": "pnpm run tsc && pnpm run svelte && pnpm run format && pnpm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:release-notes": "node scripts/check-release-notes.mjs"
  },
  "keywords": [],
  "author": "RedOracle",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@semantic-release/exec": "^7.1.0",
    "@types/debug": "^4.1.13",
    "@types/deep-equal": "^1.0.4",
    "@types/diff": "^8.0.0",
    "@types/diff3": "^0.0.2",
    "@types/node": "^22.20.2",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "moment": "^2.31.0",
    "obsidian": "^1.14.4",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "scss": "^0.2.4",
    "semantic-release": "^25.0.9",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.43.13",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "css-color-converter": "^2.0.0",
    "debug": "^4.4.3",
    "deep-equal": "^2.2.3",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "diff3": "^0.0.4",
    "isomorphic-git": "^1.44.11",
    "js-sha256": "^1.0.0",
    "simple-git": "^4.0.2",
    "supports-color": "^9.4.0",
    "svelte": "^5.57.3"
  },
  "moduleFileExtensions": [
    "js",
    "ts",
    "svelte"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  }
}
